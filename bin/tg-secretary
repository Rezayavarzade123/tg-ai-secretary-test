#!/usr/bin/env bash
#
# tg-secretary — the command for the bot you installed.
#
# One entry point for the things you actually do after an install: see whether it
# is running, get the panel link (with its token), start/stop it, read the log, run
# an update, check the machine. It works whether the bot is managed by systemd or
# started by hand, and it says which one it found instead of guessing.
#
#   tg-secretary status
#   tg-secretary panel          # prints the URL with the token, ready to paste
#   tg-secretary logs -f
#   tg-secretary update check
#
# install.sh links this into /usr/local/bin (as root) or ~/.local/bin, so after an
# install the command is just `tg-secretary`.
#
set -euo pipefail
IFS=$'\n\t'

SERVICE_NAME="secretary"
DEFAULT_PORT=8787
PROG="tg-secretary"

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  B=$'\033[1m'; D=$'\033[2m'; G=$'\033[32m'; Y=$'\033[33m'; R=$'\033[31m'; C=$'\033[36m'; N=$'\033[0m'
else
  B=''; D=''; G=''; Y=''; R=''; C=''; N=''
fi

say()  { printf '%s\n' "$*"; }
ok()   { printf '%s✔%s %s\n' "$G" "$N" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$N" "$*" >&2; }
die()  { printf '%s✖ %s%s\n' "$R" "$*" "$N" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

usage() {
  cat <<USAGE
${B}tg-secretary${N} — control the Telegram secretary on this machine

${B}Daily${N}
  status                 is it running, which version, is the model server up
  panel                  print the panel URL with its token (paste into a browser)
  token                  print just the panel token
  start [--fg]           start it (as a service, or in the foreground with --fg)
  stop                   stop it
  restart                restart it (use this after editing the settings file)
  logs [-f] [-n N]       the journal, or the last N lines

${B}Maintenance${N}
  update [check|apply|rollback]   update from GitHub; no argument means check
  selftest               run the end-to-end checks against a throwaway state dir
  hw [--bench]           what this machine can run
  paths                  where the code, settings and data are

${B}Other${N}
  version                installed version
  uninstall [--purge]    remove the service (and everything, with --purge)
  help                   this text

${B}Where it looks${N}
  --dir PATH             an install somewhere unusual
  SECRETARY_HOME=PATH    the same thing, for a shell session
  otherwise: the directory this command lives in, then /opt/tg-ai-secretary,
  then ~/tg-ai-secretary.

Exit codes: 0 fine, 1 failure, 2 usage.
USAGE
}

# --- which install ------------------------------------------------------------

EXPLICIT_DIR=""
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --dir) [ -n "${2:-}" ] || die "--dir needs a path"; EXPLICIT_DIR=$2; shift 2 ;;
    --help|-h|help) usage; exit 0 ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
set -- ${ARGS[@]+"${ARGS[@]}"}

is_install() {
  [ -n "${1:-}" ] && [ -f "$1/package.json" ] && [ -f "$1/bot/runner.mjs" ]
}

find_install() {
  local self candidate
  if [ -n "$EXPLICIT_DIR" ]; then
    is_install "$EXPLICIT_DIR" || die "No installation at $EXPLICIT_DIR (expected package.json and bot/runner.mjs).
     Check the path, or install first: bash install.sh --dir $EXPLICIT_DIR"
    printf '%s' "$EXPLICIT_DIR"; return 0
  fi
  if [ -n "${SECRETARY_HOME:-}" ]; then
    is_install "$SECRETARY_HOME" || die "SECRETARY_HOME=$SECRETARY_HOME is not an installation (no package.json or bot/runner.mjs)."
    printf '%s' "$SECRETARY_HOME"; return 0
  fi
  # Follow the symlink: the command is normally /usr/local/bin/tg-secretary ->
  # <install>/bin/tg-secretary, so the install is two levels up.
  self=$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")
  candidate=$(cd "$(dirname "$self")/.." 2>/dev/null && pwd || true)
  if is_install "$candidate"; then printf '%s' "$candidate"; return 0; fi
  for candidate in /opt/tg-ai-secretary "$HOME/tg-ai-secretary"; do
    if is_install "$candidate"; then printf '%s' "$candidate"; return 0; fi
  done
  die "I cannot find the installation.
     Run this again with --dir /path/to/tg-ai-secretary, or set SECRETARY_HOME.
     If nothing is installed yet: bash install.sh"
}

INSTALL_DIR=$(find_install)
# Works whether package.json is pretty-printed or one line.
VERSION=$(grep -o '"version"[[:space:]]*:[[:space:]]*"[^"]*"' "$INSTALL_DIR/package.json" 2>/dev/null \
  | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
STATE_DIR="$INSTALL_DIR/bot/state"
NODE_BIN=$(command -v node || true)

# The settings file install.sh writes, in the same order bot/env.mjs reads them.
SETTINGS=""
for candidate in "$INSTALL_DIR/bot/.env" "$INSTALL_DIR/.env" /etc/secretary-bot.env; do
  if [ -f "$candidate" ]; then SETTINGS=$candidate; break; fi
done

setting() {  # setting KEY [default]
  local key=$1 fallback=${2:-} line
  if [ -n "${!key:-}" ]; then printf '%s' "${!key}"; return 0; fi
  [ -n "$SETTINGS" ] || { printf '%s' "$fallback"; return 0; }
  line=$(grep -E "^[[:space:]]*(export[[:space:]]+)?$key=" "$SETTINGS" 2>/dev/null | tail -1 || true)
  [ -n "$line" ] || { printf '%s' "$fallback"; return 0; }
  line=${line#*=}
  line=${line%\"}; line=${line#\"}
  line=${line%\'}; line=${line#\'}
  printf '%s' "$line"
}

PORT=$(setting PANEL_PORT "$DEFAULT_PORT")
HOST_IP=$(setting PANEL_HOST "0.0.0.0")
PANEL_TOKEN=""
if [ -f "$STATE_DIR/panel-token" ]; then PANEL_TOKEN=$(cat "$STATE_DIR/panel-token" 2>/dev/null || true); fi
[ -n "$PANEL_TOKEN" ] || PANEL_TOKEN=$(setting PANEL_TOKEN "")

# --- which systemd, if any ----------------------------------------------------

IS_ROOT=false
[ "$(id -u)" -eq 0 ] && IS_ROOT=true

systemd_system_running() {
  have systemctl || return 1
  [ -d /run/systemd/system ] || return 1
  case "$(systemctl is-system-running 2>/dev/null || true)" in
    running|degraded|starting|initializing|maintenance) return 0 ;;
  esac
  return 1
}

systemd_user_running() {
  have systemctl || return 1
  case "$(systemctl --user is-system-running 2>/dev/null || true)" in
    running|degraded|starting|initializing|maintenance) return 0 ;;
  esac
  return 1
}

SCOPE=""                 # system | user | none
if $IS_ROOT && systemd_system_running; then SCOPE=system
elif ! $IS_ROOT && systemd_user_running; then SCOPE=user
fi

systemctl_() {
  if [ "$SCOPE" = system ]; then systemctl "$@"; else systemctl --user "$@"; fi
}

unit_path() {
  if [ "$SCOPE" = system ]; then printf '/etc/systemd/system/%s.service' "$SERVICE_NAME"
  else printf '%s/systemd/user/%s.service' "${XDG_CONFIG_HOME:-$HOME/.config}" "$SERVICE_NAME"; fi
}

service_installed() {
  [ -n "$SCOPE" ] && [ -f "$(unit_path)" ]
}

panel_url() {
  printf 'http://127.0.0.1:%s' "$PORT"
}

panel_answers() {
  have curl || return 1
  curl -fsS --max-time 1 "$(panel_url)/api/ping" >/dev/null 2>&1
}

# Processes started by hand are launched from the install directory with a
# relative script name, so matching the command line alone is unreliable — the
# working directory is what identifies this install.
pids_running() {
  local pid cwd_here
  cwd_here=$(readlink -f "$INSTALL_DIR" 2>/dev/null || printf '%s' "$INSTALL_DIR")
  for pid in $(pgrep -f 'bot/runner\.mjs' 2>/dev/null || true); do
    if [ "$(readlink -f "/proc/$pid/cwd" 2>/dev/null || true)" = "$cwd_here" ]; then
      printf '%s\n' "$pid"
    fi
  done
}

# The panel is part of the bot process, so an answering panel is the strongest
# signal available; the pid check covers the seconds before it binds.
running() {
  if service_installed; then systemctl_ is-active --quiet "$SERVICE_NAME"; return; fi
  [ -n "$(pids_running)" ] || panel_answers
}

need_node() {
  [ -n "$NODE_BIN" ] || die "node is not on PATH. Install Node.js 20, or add it to PATH."
}

# The bot's own entry point, run from the install directory so relative imports
# and bot/state resolve exactly as they do under the service.
node_here() {
  ( cd "$INSTALL_DIR" && "$NODE_BIN" "$@" )
}

# --- commands -----------------------------------------------------------------

cmd_status() {
  local state panel model
  if running; then state="${G}running${N}"; else state="${Y}not running${N}"; fi

  say "${B}tg-secretary${N} $VERSION"
  say "  code        $INSTALL_DIR"
  say "  settings    ${SETTINGS:-none (defaults, plus the panel)}"
  say "  data        $STATE_DIR"
  if service_installed; then
    say "  service     $(systemctl_ is-active "$SERVICE_NAME" 2>/dev/null || true) ($SCOPE, $(unit_path))"
  elif [ -n "$SCOPE" ]; then
    say "  service     not installed — started by hand"
  else
    say "  service     systemd is not available here"
  fi
  say "  bot         $state"

  if panel_answers; then panel="${G}answering${N} on $(panel_url)"; else panel="${D}not answering${N} on $(panel_url)"; fi
  say "  panel       $panel"
  if [ -n "$PANEL_TOKEN" ]; then say "  token       ${PANEL_TOKEN}"; else say "  token       ${Y}not created yet${N} (it is written at first start)"; fi

  # The model server is the other half of the chain; a green panel and a dead
  # model server looks like "the bot is broken", so check it here.
  local base
  base=$(setting LLM_BASE_URL "http://127.0.0.1:8080")
  if have curl && curl -fsS --max-time 2 "${base%/}/v1/models" >/dev/null 2>&1; then
    model="${G}online${N} at $base"
  else
    model="${Y}not answering${N} at $base (llama-server or Ollama not started?)"
  fi
  say "  model       $model"

  if [ -f "$STATE_DIR/bot.json" ]; then
    local drafts size
    size=$(du -h "$STATE_DIR/bot.json" 2>/dev/null | cut -f1 || true)
    drafts=$(grep -o '"status": *"pending"' "$STATE_DIR/bot.json" 2>/dev/null | wc -l | tr -d ' ' || true)
    say "  data file   ${size:-?}${drafts:+ · ${drafts} pending draft(s)}"
  fi
}

cmd_panel() {
  if [ -z "$PANEL_TOKEN" ]; then
    die "No panel token yet. Start the bot once ($PROG start); the token is printed then."
  fi
  if ! panel_answers && ! running; then
    warn "The panel is not answering; the bot may be stopped. Start it with: $PROG start"
  fi
  local url
  url="$(panel_url)/?token=$PANEL_TOKEN"
  say "$url"
  if [ "$HOST_IP" = "0.0.0.0" ]; then
    local lan
    lan=$(hostname -I 2>/dev/null | awk '{print $1}' || true)
    [ -n "$lan" ] && say "${D}from another device on your network: http://$lan:$PORT/?token=$PANEL_TOKEN${N}" >&2
  fi
}

cmd_token() {
  [ -n "$PANEL_TOKEN" ] || die "No panel token yet. Start the bot once ($PROG start)."
  say "$PANEL_TOKEN"
}

cmd_start() {
  local fg=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --fg|--foreground) fg=true; shift ;;
      *) die "start: unknown option $1" ;;
    esac
  done

  if running && ! $fg; then
    ok "Already running$(service_installed && printf ' (%s)' "$(systemctl_ is-active "$SERVICE_NAME" 2>/dev/null)")"
    cmd_panel >/dev/null 2>&1 || true
    return 0
  fi

  if $fg || ! service_installed; then
    need_node
    if ! service_installed; then
      [ -n "$SCOPE" ] && warn "No service installed; running in the foreground (install.sh --service sets one up)."
    fi
    say "${D}Ctrl+C stops it. The panel URL is printed at start-up.${N}"
    cd "$INSTALL_DIR"
    exec "$NODE_BIN" --import ./bot/register.mjs bot/runner.mjs
  fi

  systemctl_ start "$SERVICE_NAME"
  for _ in $(seq 1 40); do
    if panel_answers; then ok "Started — panel on $(panel_url)"; return 0; fi
    sleep 0.5
  done
  warn "The service was started but the panel is not answering yet. Check: $PROG logs -n 30"
  return 1
}

cmd_stop() {
  if service_installed; then
    systemctl_ stop "$SERVICE_NAME" || die "Could not stop the service."
    ok "Stopped"
    return 0
  fi
  local pids
  pids=$(pids_running)
  if [ -n "$pids" ]; then
    # SIGTERM makes it save state and release the lock; killing it hard would
    # leave a stale lock and lose whatever the last save missed.
    kill $pids 2>/dev/null || true
    for _ in $(seq 1 20); do
      [ -z "$(pids_running)" ] && break
      sleep 0.5
    done
    if [ -n "$(pids_running)" ]; then
      warn "It did not stop after 10 seconds; sending a hard kill (state may be stale)"
      kill -9 $(pids_running) 2>/dev/null || true
    fi
    ok "Stopped (it was running by hand)"
    return 0
  fi
  say "Not running."
}

cmd_restart() {
  if ! service_installed; then
    say "No service to restart; starting it instead."
    cmd_start "$@"
    return 0
  fi
  systemctl_ restart "$SERVICE_NAME"
  for _ in $(seq 1 40); do
    if panel_answers; then ok "Restarted — panel on $(panel_url)"; return 0; fi
    sleep 0.5
  done
  warn "Restarted, but the panel is not answering yet. Check: $PROG logs -n 30"
  return 1
}

cmd_logs() {
  local follow=false lines=50
  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--follow) follow=true; shift ;;
      -n) [ -n "${2:-}" ] || die "logs -n needs a number"; lines=$2; shift 2 ;;
      *) die "logs: unknown option $1" ;;
    esac
  done

  if service_installed; then
    local args=(-u "$SERVICE_NAME" -n "$lines" --no-pager)
    $follow && args+=(-f)
    systemctl_ journalctl "${args[@]}" 2>/dev/null || journalctl "${args[@]}"
    return 0
  fi
  warn "No service, so there is no journal. Run it in the foreground to see output:"
  say "    $PROG start --fg"
}

# The updater is Node, so it is one implementation for every platform; the front
# ends only differ in how they restart things.
cmd_update() {
  need_node
  node_here bot/cli.mjs update "$@"
}

cmd_selftest() {
  need_node
  local dir
  dir=$(mktemp -d 2>/dev/null || echo "/tmp/secretary-selftest-$$")
  BOT_STATE_DIR=$dir node_here --import ./bot/register.mjs bot/selftest.mjs
  local rc=$?
  rm -rf "$dir"
  return $rc
}

cmd_hw() {
  need_node
  node_here bot/hardware.mjs "$@"
}

cmd_paths() {
  say "install   $INSTALL_DIR"
  say "settings  ${SETTINGS:-none}"
  say "state     $STATE_DIR"
  say "token     $STATE_DIR/panel-token"
  say "backups   $STATE_DIR/backups"
}

cmd_version() { say "$PROG $VERSION"; }

cmd_uninstall() {
  local purge=()
  [ "${1:-}" = "--purge" ] && purge=(--purge)
  if [ -f "$INSTALL_DIR/uninstall.sh" ]; then
    exec bash "$INSTALL_DIR/uninstall.sh" --dir "$INSTALL_DIR" ${purge[@]+"${purge[@]}"}
  fi
  die "No uninstall.sh in $INSTALL_DIR. Remove the directory by hand."
}

# --- dispatch -----------------------------------------------------------------

CMD=${1:-status}
[ $# -gt 0 ] && shift

case "$CMD" in
  status)     cmd_status ;;
  panel|open) cmd_panel ;;
  token)      cmd_token ;;
  start)      cmd_start "$@" ;;
  stop)       cmd_stop ;;
  restart)    cmd_restart "$@" ;;
  logs)       cmd_logs "$@" ;;
  update)     cmd_update "$@" ;;
  selftest)   cmd_selftest ;;
  hw)         cmd_hw "$@" ;;
  paths)      cmd_paths ;;
  version|-v|--version) cmd_version ;;
  uninstall)  cmd_uninstall "$@" ;;
  help|--help|-h) usage ;;
  *)
    warn "Unknown command: $CMD"
    say ""
    usage
    exit 2
    ;;
esac
