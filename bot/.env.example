# Copy to bot/.env and fill in. Values here are read at start-up;
# most can also be changed later in the control panel.
# Keep this file private: chmod 600 bot/.env

# --- Telegram ------------------------------------------------------------------
# The token from @BotFather (NOT the Serverless CLI token).
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: your numeric Telegram id. You can also just send /claim to the bot.
BOT_OWNER_ID=

# --- Model server ---------------------------------------------------------------
# llama.cpp:  http://127.0.0.1:8080
# Ollama:     http://127.0.0.1:11434/v1
LLM_BASE_URL=http://127.0.0.1:8080

# Only needed if the server was started with --api-key, or for the cloud brain.
LLM_API_KEY=

# Label for the model (llama-server serves whatever GGUF it was loaded with).
BOT_MODEL=qwen3-1.7b

# local | cloud  (cloud = Ollama's hosted API, needs a key)
LLM_PROVIDER=local

# --- Control panel ---------------------------------------------------------------
# Open http://<machine-ip>:8787 — the token is printed at start-up and stored in
# bot/state/panel-token. Set it here if you want a fixed one.
PANEL_PORT=8787
# Bind to 127.0.0.1 to make the panel reachable only from the machine itself.
PANEL_HOST=0.0.0.0
PANEL_TOKEN=

# --- Behaviour --------------------------------------------------------------------
BOT_TIMEZONE=Asia/Tehran
BOT_LANG=en

# draft = you approve every secretary reply, auto = send after the safety checks
SECRETARY_MODE=draft

# Conversation memory sent to the model. Keep small: small machines are slow.
HISTORY_LIMIT=10
HISTORY_LIMIT_SECRETARY=6

# Token budget per reply.
NUM_PREDICT_BOT=400
NUM_PREDICT_SECRETARY=200
